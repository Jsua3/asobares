APP_NAME="ASOBARES Quindío"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# IPs del balanceador que hay delante de la aplicacion, separadas por coma.
# Vacio en local, porque no hay balanceador. En cualquier hosting va relleno:
# sin esto TODAS las peticiones parecen venir de la misma IP —los limites por
# IP colapsan en un solo cubo— y las URLs se generan en http, incluida la
# `callback_url` que se le manda a Bold. Laravel Cloud no publica las IPs de
# su balanceador, asi que alli el valor es `*`.
TRUSTED_PROXIES=

# Español de Colombia: toda la interfaz publica y el panel van en es.
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES
APP_TIMEZONE=America/Bogota

# `file` escribe storage/framework/maintenance.php en el disco de UNA maquina.
# En un hosting con varias instancias eso deja en mantenimiento solo a una y
# las demas siguen sirviendo: fuera de local va `cache` + store `database`.
APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
# En un hosting de disco efimero el canal tiene que ser `stderr`: es lo unico
# que lee `cloud environment:logs`. Con `single` el registro muere en un
# fichero que nadie puede abrir, y con el mueren los codigos MFA del panel.
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# SQLite para el demo. Las migraciones son portables a PostgreSQL sin cambios.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=asobares
# DB_USERNAME=
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
# Sin `Secure` la cookie de sesion viaja tambien por http y cualquiera en la
# misma red la captura y la reutiliza. `config/session.php` solo la marca sola
# cuando APP_ENV=production, y el entorno remoto se llama `staging`: fuera de
# local esta variable va explicita en `true`.
SESSION_SECURE_COOKIE=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
# Las imagenes subidas se sirven desde storage/app/public (requiere storage:link).
# AVISO para cualquier hosting serverless: `public` y `local` son discos LOCALES
# sobre storage_path(). Lo que se suba desde el panel se pierde en el siguiente
# despliegue y no se comparte entre instancias. Ver docs/ingenieria/runbook-despliegue.md.
FILESYSTEM_DISK=public
MEDIA_DISK=public
# sync en el demo: las conversiones de imagen y las notificaciones corren en linea.
# No es un descuido, es una decision: no hay app/Jobs/, ningun ShouldQueue y los
# cinco envios de correo son sincronos.
QUEUE_CONNECTION=sync
# Trampa de media-library: su config trae `queue_conversions_by_default` en true
# y lee QUEUE_CONNECTION. Hoy funciona porque la conexion es `sync`; el dia que
# alguien la cambie a `database` «para hacerlo bien», las conversiones se
# encolan y mueren en la tabla `jobs` sin error y sin miniaturas.
QUEUE_CONVERSIONS_BY_DEFAULT=false

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# En el demo el correo se escribe en storage/logs/laravel.log (no sale nada real).
# Fuera de local `log` esta PROHIBIDO y la aplicacion se niega a arrancar con el:
# escribiria cada PQR, con los datos personales del ciudadano, en el registro.
# El unico transporte instalado que funciona sin dependencias nuevas es `smtp`
# (no hay symfony/postmark-mailer, ni amazon-mailer, ni resend/resend-laravel).
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="asobaresquindio@asobares.org"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Pasarela de pagos
# ---------------------------------------------------------------------------
# fake = pasarela simulada interna; permite demostrar el flujo completo sin credenciales.
# bold = pasarela real de Bold (developers.bold.co). Requiere las llaves de abajo.
PAYMENT_DRIVER=fake

# Ambas llaves salen del modulo de integraciones del comercio en Bold.
# BOLD_API_KEY: llave de identidad; viaja como `Authorization: x-api-key ...`.
# BOLD_SECRET: llave con la que Bold firma el webhook (encabezado x-bold-signature).
#   En el sandbox de Bold la firma se calcula con llave VACIA: dejala en blanco
#   con BOLD_SANDBOX=true. Fuera del sandbox, una llave vacia rechaza todo.
BOLD_API_KEY=
BOLD_SECRET=
BOLD_SANDBOX=true
BOLD_API_URL=https://integrations.api.bold.co

# Montos de referencia del gremio, en pesos. Los lee config/pagos.php.
VALOR_MENSUALIDAD=50000
VALOR_AFILIACION=150000

# Retención de datos personales (Ley 1581 de 2012). Un valor menor que 1 no
# desactiva la purga: el comando correspondiente aborta con error.
RETENCION_POSTULACIONES_MESES=6
RETENCION_POSTULACIONES_MAXIMO_MESES=12
RETENCION_ASPIRANTES_MESES=12
RETENCION_CONTACTO_MESES=12
RETENCION_PQR_MESES=24
RETENCION_INSCRIPCIONES_MESES=24

# Las galerias de los establecimientos destacados son 36 conversiones a webp.
# Correcto para el demo; la suite las apaga desde phpunit.xml.
SEED_GALERIA=true
