# =============================================================================
# ASOBARES Quindio — entorno REMOTO (Laravel Cloud, entorno `staging`)
# =============================================================================
#
# Este fichero NO se usa en local. Es la referencia versionada de lo que hay
# que pegar en las variables del entorno de Laravel Cloud
# (`cloud environment:variables`). El procedimiento completo, con la secuencia
# de comandos y el paso humano que lo bloquea, esta en
# docs/ingenieria/runbook-despliegue.md — leelo ANTES de pegar nada.
#
# Convencion de este fichero: cada variable que se APARTA del perfil de
# demostracion (.env.example) lleva encima el porque. Las que valen lo mismo
# van sin comentario.
#
# Los cuatro valores que hay que rellenar a mano estan marcados con <...>.
# No hay ni una credencial real escrita aqui, y no debe haberla nunca.
# -----------------------------------------------------------------------------

# --- Identidad y arranque ----------------------------------------------------
APP_NAME="ASOBARES Quindío"

# `staging` y no `production` porque los sembradores de demostracion tienen
# que poder correr (§20.5.5 del prompt maestro): en `production` DatabaseSeeder
# se niega en bloque. Ojo: desde este trabajo, `staging` ya NO es un entorno
# blando. AppServiceProvider endurece TODO lo que no sea local ni testing, asi
# que aqui se fuerza https, se marca la cookie `Secure`, y la aplicacion se
# niega a arrancar con APP_DEBUG=true o con MAIL_MAILER=log.
APP_ENV=staging

# La genera Cloud durante el `ship`. NO reutilizar la clave de la maquina
# local: con ella se descifran las cookies y todo lo cifrado en la base.
APP_KEY=<la genera Cloud; no copiar la local>

APP_DEBUG=false

# Se rellena DESPUES del primer `cloud ship`, con la URL que devuelva.
# Tiene que empezar por https.
APP_URL=<https://el-subdominio-que-asigne-cloud>

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES
APP_TIMEZONE=America/Bogota
BCRYPT_ROUNDS=12

# `file` escribiria el flag de mantenimiento en el disco de UNA instancia: las
# demas seguirian sirviendo y `php artisan up` podria no encontrar el fichero.
# Con `cache` sobre `database` el flag vive en Postgres y lo ven todas.
APP_MAINTENANCE_DRIVER=cache
APP_MAINTENANCE_STORE=database

# --- Red ---------------------------------------------------------------------

# BLOQUEANTE. Sin esto no hay NADA en la cadena que produzca https: todas las
# peticiones parecen venir del balanceador (los limites por IP colapsan en un
# solo cubo) y las URLs se generan en http, incluida la `callback_url` que
# recibe Bold. Cloud no publica las IPs de su balanceador, asi que el valor es
# el comodin, que es el caso que bootstrap/app.php ya contempla.
TRUSTED_PROXIES=*

# --- Registro ----------------------------------------------------------------

LOG_CHANNEL=stack

# BLOQUEANTE. `single` escribe en storage/logs/laravel.log, un fichero del
# disco efimero de la instancia que `cloud environment:logs` no lee. Con
# `stderr` el registro sale por donde Cloud lo recoge — y es la unica forma de
# leer los codigos MFA del panel mientras no haya proveedor de correo.
LOG_STACK=stderr

# `debug` en un entorno expuesto vuelca las consultas y sus parametros.
LOG_LEVEL=info
LOG_DEPRECATIONS_CHANNEL=null

# --- Base de datos -----------------------------------------------------------

# Cloud inyecta DB_HOST, DB_PORT, DB_DATABASE, DB_USERNAME y DB_PASSWORD del
# Postgres serverless, pero NO inyecta DB_CONNECTION. Si se olvida, el defecto
# silencioso de config/database.php es `sqlite`: la aplicacion intenta abrir
# database/database.sqlite en el disco efimero y el sitio entero da 500 con
# las variables de Postgres correctamente puestas al lado.
DB_CONNECTION=pgsql

# `prefer` acepta una conexion sin cifrar si el servidor no la ofrece.
DB_SSLMODE=require

# --- Sesion, cache y cola ----------------------------------------------------

SESSION_DRIVER=database

# config/session.php solo lo pone solo cuando APP_ENV=production, y aqui el
# entorno es `staging`. AppServiceProvider ya lo fuerza en arranque, pero se
# deja explicito: una coraza no se apoya en un solo tornillo.
SESSION_SECURE_COOKIE=true

SESSION_SAME_SITE=lax
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

# Obligatoriamente un almacen COMPARTIDO. Los ajustes del sitio se memorizan
# con rememberForever y se invalidan por evento de modelo: un almacen por
# instancia se desincroniza y unas instancias sirven ajustes viejos.
CACHE_STORE=database

# Decision, no descuido: no hay app/Jobs/, ningun ShouldQueue, y los cinco
# envios de correo son sincronos. Cambiarlo a `database` sin levantar antes un
# background-process en Cloud rompe las miniaturas en silencio (ver abajo).
QUEUE_CONNECTION=sync

# Seguro contra ese cambio: media-library encola sus conversiones por defecto.
QUEUE_CONVERSIONS_BY_DEFAULT=false

# --- Ficheros ----------------------------------------------------------------

# AVISO GRANDE, leer el apartado «Almacenamiento» del runbook.
# Donde viven los archivos que sube el gremio. `public` y `local` son discos
# LOCALES sobre storage_path(), y en un entorno serverless el disco es efimero:
# lo que la tutora suba desde el panel desaparece en el siguiente despliegue y
# no se ve desde las otras instancias. El contenido de las semillas no se
# pierde, porque viaja dentro del sembrador; lo que se sube a mano, si.
#
# Con el bucket creado, estas dos son las unicas que hay que cambiar:
#
#     DISCO_PUBLICO=s3
#     DISCO_PRIVADO=s3-privado
#
# ⚠️ NO basta con FILESYSTEM_DISK ni con MEDIA_DISK, y esto esta comprobado:
# los puntos de subida nombran su disco de forma explicita —tienen que hacerlo,
# porque la diferencia entre los dos es de seguridad y no de configuracion—, y
# `Asociado::registerMediaCollections()` llama a `useDisk()`, que pisa a
# MEDIA_DISK. Las dos se dejan alineadas por si algun dia se anade un modelo
# que si use el disco por defecto.
DISCO_PUBLICO=public
DISCO_PRIVADO=local
FILESYSTEM_DISK=public
MEDIA_DISK=public

# --- Almacenamiento de objetos (rellenar al crear el bucket) -----------------
#
# El driver ya esta instalado (league/flysystem-aws-s3-v3) y probado contra un
# almacen compatible con S3: subida, descarga por GuiaController y URL publica.
#
# ⚠️⚠️ LA POLITICA DEL BUCKET ES LA FRONTERA DE SEGURIDAD, Y LA NATURAL ESTA MAL.
# Conceder `s3:GetObject` sobre `arn:aws:s3:::<bucket>/*` deja los formatos
# oficiales de la guia normativa descargables por URL directa —medido: 200 sin
# pasar por GuiaController, que es donde se comprueba que el requisito este
# publicado—. La politica tiene que acotarse al prefijo publico:
#
#     "Resource": ["arn:aws:s3:::<bucket>/publico/*"]
#
# Con esa correccion, medido: lo publico responde 200 y lo privado 403.
# El apartado 8 del runbook lo explica entero.
#
# AWS_ACCESS_KEY_ID=<lo da `cloud bucket:create`>
# AWS_SECRET_ACCESS_KEY=<idem>
# AWS_DEFAULT_REGION=us-east-1
# AWS_BUCKET=<nombre del bucket>
# AWS_ENDPOINT=<endpoint del bucket>
# AWS_URL=<url publica del bucket>
# AWS_USE_PATH_STYLE_ENDPOINT=true

# --- Correo ------------------------------------------------------------------

# `smtp` es el UNICO transporte instalado. `resend`, `postmark` y `ses`
# revientan en tiempo de ejecucion: no estan sus paquetes en vendor/.
# `log` esta prohibido y la aplicacion se niega a arrancar con el.
# Cualquier proveedor (Resend, Postmark, Brevo) publica endpoint SMTP; el
# ejemplo de abajo es el de Resend y se cambia por el que contrate el gremio.
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=smtp.resend.com
MAIL_PORT=587
MAIL_USERNAME=resend
MAIL_PASSWORD=<clave SMTP de la cuenta del gremio>
MAIL_FROM_ADDRESS="asobaresquindio@asobares.org"
MAIL_FROM_NAME="${APP_NAME}"

# --- Pagos -------------------------------------------------------------------

# La pasarela simulada se niega a existir fuera de local y testing, asi que el
# driver tiene que ser `bold`. Sin llaves de Bold, el enlace de pago falla a
# proposito: es lo decidido (§20.5.2, los pagos NO se demuestran en este
# hosting). Lo que ya no pasa es que ese fallo se vea como una pagina 500:
# EventoController y MiCuentaController lo capturan y avisan con una frase.
PAYMENT_DRIVER=bold
BOLD_API_KEY=
BOLD_SECRET=

# `false` porque no se esta contra el sandbox: con la llave vacia, una firma
# vacia rechazaria todo, que es el comportamiento correcto aqui.
BOLD_SANDBOX=false
BOLD_API_URL=https://integrations.api.bold.co

VALOR_MENSUALIDAD=50000
VALOR_AFILIACION=150000

# --- Retencion de datos personales (Ley 1581 de 2012) ------------------------
# Identicas al perfil de demostracion.
RETENCION_POSTULACIONES_MESES=6
RETENCION_POSTULACIONES_MAXIMO_MESES=12
RETENCION_ASPIRANTES_MESES=12
RETENCION_CONTACTO_MESES=12
RETENCION_PQR_MESES=24
RETENCION_INSCRIPCIONES_MESES=24

# --- Semilla y compilacion ---------------------------------------------------
SEED_GALERIA=true
VITE_APP_NAME="${APP_NAME}"
